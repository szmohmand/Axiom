[Unit]
Description=AXIOM independent whole-book Japanese candlestick research shadow
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=axiom
Group=axiom
WorkingDirectory=/opt/axiom/nison-full
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m research.nison_full_shadow_study collect
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=axiom-nison-full-study
StateDirectoryMode=0700
# Existing /opt/axiom/current, /etc/axiom, and live bot.sqlite3
# are not writable by this research study.
[Install]
WantedBy=multi-user.target
