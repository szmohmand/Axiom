[Unit]
Description=AXIOM isolated Nison 100-contract read-only shadow study
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=axiom
Group=axiom
WorkingDirectory=/opt/axiom/candle-study
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m research.candlestick_shadow_study collect --database /var/lib/axiom-candle-study/study.sqlite3 --interval 8
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=axiom-candle-study
StateDirectoryMode=0700
# This process has no authenticated API client, secret path, order code,
# or writes to the active AXIOM installation or its production ledger.
[Install]
WantedBy=multi-user.target
