# Server-only environment copied to /etc/axiom/axiom.env; mode 0600.
DEMO_MODE=0
AUTO_PAPER=0
POLL_SECONDS=5
DATA_PATH=/var/lib/axiom/bot.sqlite3
BOT_ADMIN_TOKEN=
BRTI_LIVE_ENABLED=0
# Configure these only on server, never in GitHub:
# KALSHI_API_KEY_ID=
# Single quoted literal \n-separated PEM; signer expands escaped newlines:
# KALSHI_PRIVATE_KEY_PEM='-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----'
# Public Binance BTCUSDT spot aggregate-trade WS and published USD-M BTC perpetual funding.
# Unavailable or geographically restricted endpoints fail closed; no signal is fabricated.
BINANCE_INTELLIGENCE_ENABLED=1
