# DEMO_MODE=1 uses explicitly synthetic offline market data. Set to 0 for live public feeds.
DEMO_MODE=0
# Automatic SIMULATED entries when experimental estimated edge >= 8 points before fees.
AUTO_PAPER=1
POLL_SECONDS=15
# Set a long random value to unlock manual paper entries and ledger exports.
BOT_ADMIN_TOKEN=replace-with-a-random-long-secret
# SQLite ledger path. For cloud hosting, configure a persistent disk.
DATA_PATH=./data/bot.sqlite3
